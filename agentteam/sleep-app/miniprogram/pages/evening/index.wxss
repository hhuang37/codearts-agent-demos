.page-evening {
  padding: var(--space-3);
}

.page-evening__hero {
  background: linear-gradient(180deg, #1a1b3a 0%, #2a2c5e 100%);
  border-radius: var(--radius-card);
  padding: var(--space-4) var(--space-3);
  color: var(--color-white);
  margin-bottom: var(--space-3);
}

.page-evening__title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  margin-bottom: var(--space-1);
}

.page-evening__subtitle {
  font-size: var(--font-size-base);
  opacity: 0.9;
  margin-bottom: var(--space-1);
}

.page-evening__time {
  font-size: var(--font-size-sm);
  opacity: 0.7;
}

.page-evening__sound {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-2);
}

.page-evening__sound-name {
  font-size: var(--font-size-base);
  color: var(--color-text);
}

.page-evening__textarea {
  width: 100%;
  min-height: 160rpx;
  padding: var(--space-2);
  background-color: rgba(26, 27, 58, 0.04);
  border-radius: var(--radius-input);
  font-size: var(--font-size-base);
  color: var(--color-text);
  box-sizing: border-box;
  margin-bottom: var(--space-2);
}

.page-evening__check {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  margin-bottom: var(--space-2);
}

.page-evening__check-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-sub);
}

.page-evening__sky-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-aux);
}