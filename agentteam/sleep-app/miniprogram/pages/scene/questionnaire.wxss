.page-questionnaire {
  padding: var(--space-3);
}

.page-questionnaire__progress {
  width: 100%;
  height: 8rpx;
  background-color: rgba(26, 27, 58, 0.06);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: var(--space-2);
}

.page-questionnaire__bar {
  height: 100%;
  background-color: var(--color-primary);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.page-questionnaire__step {
  font-size: var(--font-size-xs);
  color: var(--color-text-aux);
  margin-bottom: var(--space-3);
}

.page-questionnaire__options {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.page-questionnaire__opt {
  padding: var(--space-2) var(--space-3);
  background-color: rgba(26, 27, 58, 0.04);
  border-radius: var(--radius-input);
  font-size: var(--font-size-base);
  color: var(--color-text);
}

.page-questionnaire__opt--active {
  background-color: var(--color-primary);
  color: var(--color-white);
}

.page-questionnaire__actions {
  display: flex;
  gap: var(--space-2);
  justify-content: center;
  margin-top: var(--space-4);
}