/* 登录页样式（pages/login/index.wxss） */

.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1A1B3A 0%, #2E3070 100%);
  padding: 200rpx 64rpx 80rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  text-align: center;
  margin-bottom: 120rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.logo-title {
  font-size: 56rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
}

.logo-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.agreement {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  width: 100%;
}

.agreement-text {
  flex: 1;
  line-height: 1.6;
}

.link {
  color: var(--color-accent, #FFD66B);
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: var(--color-accent, #FFD66B);
  color: var(--color-primary, #1A1B3A);
  border-radius: 48rpx;
  text-align: center;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.login-btn.disabled {
  opacity: 0.5;
}

.skip-btn {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}