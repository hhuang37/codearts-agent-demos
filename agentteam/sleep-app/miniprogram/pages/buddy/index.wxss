/* 睡眠搭子页样式（pages/buddy/index.wxss） */

.buddy-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0E1130 0%, #1A1B3A 60%, #2E3070 100%);
  padding: 80rpx 32rpx 80rpx;
  box-sizing: border-box;
  color: #fff;
}

.hero {
  text-align: center;
  margin-bottom: 80rpx;
}

.hero-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 48rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.card-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 16rpx;
}

.counter {
  font-size: 96rpx;
  font-weight: 600;
  color: var(--color-accent, #FFD66B);
  line-height: 1;
}

.card-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 8rpx;
}

.match-btn {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: var(--color-accent, #FFD66B);
  color: var(--color-primary, #1A1B3A);
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.match-btn.disabled {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.5);
}

.tip {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}