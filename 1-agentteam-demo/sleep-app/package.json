{
  "name": "sleepbuddy-miniprogram",
  "version": "1.0.0",
  "description": "陪你睡个好觉 - 微信小程序睡眠助手 MVP",
  "private": true,
  "scripts": {
    "dev": "echo \"请使用微信开发者工具打开 miniprogram/ 目录\" && npm run type-check",
    "build": "npm run type-check && echo \"构建完成\"",
    "lint": "eslint --ext .ts miniprogram/",
    "lint:fix": "eslint --ext .ts --fix miniprogram/",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"miniprogram/**/*.{ts,wxml,wxss,json}\"",
    "format:check": "prettier --check \"miniprogram/**/*.{ts,wxml,wxss,json}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "author": "SleepBuddy Team",
  "license": "MIT"
}