/* 智能闹钟页样式（pages/alarm/index.wxss） */

.alarm-page {
  min-height: 100vh;
  background: var(--color-bg, #F4F6FA);
  padding: 32rpx 32rpx 160rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text, #1A1B3A);
}

.subtitle {
  font-size: 26rpx;
  color: var(--color-muted, #6B6F8A);
  margin-top: 8rpx;
}

.holiday-tip {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 214, 107, 0.18);
  color: #B07A00;
  border-radius: 16rpx;
  font-size: 24rpx;
  display: inline-block;
}

.empty {
  margin-top: 120rpx;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--color-text, #1A1B3A);
  font-weight: 500;
}

.empty-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-muted, #6B6F8A);
}

.alarm-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.alarm-item {
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 27, 58, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.alarm-main {
  flex: 1;
}

.alarm-time {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--color-text, #1A1B3A);
  font-family: monospace;
}

.alarm-meta {
  margin-top: 8rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.meta-tag {
  font-size: 22rpx;
  color: var(--color-muted, #6B6F8A);
  background: rgba(107, 111, 138, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.alarm-repeat {
  margin-top: 12rpx;
  display: flex;
  gap: 8rpx;
}

.day-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(107, 111, 138, 0.1);
  color: var(--color-muted, #6B6F8A);
}

.day-dot.active {
  background: var(--color-primary, #1A1B3A);
  color: #fff;
}

.alarm-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}

.row-buttons {
  display: flex;
  gap: 16rpx;
}

.text-btn {
  font-size: 24rpx;
  color: var(--color-primary, #1A1B3A);
  padding: 4rpx 8rpx;
}

.text-btn.danger {
  color: #E55B5B;
}

.fab {
  position: fixed;
  bottom: 48rpx;
  left: 50%;
  transform: translateX(-50%);
  background: var(--color-primary, #1A1B3A);
  color: #fff;
  border-radius: 48rpx;
  padding: 20rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 27, 58, 0.25);
}

.fab-plus {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

.fab-label {
  font-size: 28rpx;
  font-weight: 500;
}

/* 编辑弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--color-muted, #6B6F8A);
  margin: 24rpx 0 12rpx;
}

.form-label-inline {
  font-size: 28rpx;
  color: var(--color-text, #1A1B3A);
}

.time-pick {
  background: var(--color-bg, #F4F6FA);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  font-family: monospace;
}

.day-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.day-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  background: var(--color-bg, #F4F6FA);
  text-align: center;
  line-height: 72rpx;
  font-size: 26rpx;
  color: var(--color-muted, #6B6F8A);
}

.day-btn.active {
  background: var(--color-primary, #1A1B3A);
  color: #fff;
}

.form-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-buttons {
  margin-top: 40rpx;
  display: flex;
  gap: 24rpx;
}

.btn-secondary,
.btn-primary {
  flex: 1;
  height: 88rpx;
  border-radius: 48rpx;
  text-align: center;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-secondary {
  background: var(--color-bg, #F4F6FA);
  color: var(--color-text, #1A1B3A);
}

.btn-primary {
  background: var(--color-primary, #1A1B3A);
  color: #fff;
}