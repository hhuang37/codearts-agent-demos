/* 白噪音页样式（pages/soundscape/index.wxss） */

.ss-page {
  min-height: 100vh;
  background: var(--color-bg, #F4F6FA);
  padding: 32rpx 32rpx 200rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text, #1A1B3A);
  margin-bottom: 24rpx;
}

.search-bar {
  background: #fff;
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 27, 58, 0.04);
}

.search-input {
  height: 56rpx;
  font-size: 26rpx;
  color: var(--color-text, #1A1B3A);
}

.tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  background: #fff;
  color: var(--color-muted, #6B6F8A);
  font-size: 26rpx;
  border: 2rpx solid transparent;
}

.tab.active {
  background: var(--color-primary, #1A1B3A);
  color: #fff;
}

.loading,
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: var(--color-muted, #6B6F8A);
  font-size: 26rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.ss-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ss-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 27, 58, 0.04);
}

.ss-item.current {
  border: 2rpx solid var(--color-accent, #FFD66B);
}

.ss-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #5B5F8F, #1A1B3A);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ss-cover-text {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.ss-info {
  flex: 1;
  min-width: 0;
}

.ss-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text, #1A1B3A);
  margin-bottom: 8rpx;
}

.ss-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.tag-mini {
  font-size: 20rpx;
  color: var(--color-muted, #6B6F8A);
  background: rgba(107, 111, 138, 0.08);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.badge-premium {
  font-size: 22rpx;
  background: var(--color-accent, #FFD66B);
  color: var(--color-primary, #1A1B3A);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.play-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-primary, #1A1B3A);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.play-icon.muted {
  background: rgba(107, 111, 138, 0.15);
  color: var(--color-muted, #6B6F8A);
  font-size: 28rpx;
}

/* 底部播放控制条 */
.player-bar {
  position: fixed;
  bottom: 120rpx;
  left: 32rpx;
  right: 32rpx;
  background: var(--color-primary, #1A1B3A);
  color: #fff;
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 24rpx rgba(26, 27, 58, 0.25);
}

.player-info {
  flex: 1;
}

.player-title {
  font-size: 26rpx;
  font-weight: 500;
}

.player-subtitle {
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 4rpx;
}

.player-controls {
  display: flex;
  gap: 12rpx;
}

.ctrl-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.ctrl-btn.primary {
  background: var(--color-accent, #FFD66B);
  color: var(--color-primary, #1A1B3A);
  font-size: 32rpx;
}

/* 定时选择面板 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.timer-sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  margin-bottom: 32rpx;
  color: var(--color-text, #1A1B3A);
}

.timer-item {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--color-text, #1A1B3A);
  border-bottom: 2rpx solid rgba(107, 111, 138, 0.08);
}

.sheet-cancel {
  margin-top: 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: var(--color-bg, #F4F6FA);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--color-muted, #6B6F8A);
}