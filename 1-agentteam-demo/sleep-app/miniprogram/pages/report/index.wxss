.page-report {
  padding: var(--space-3);
}

.page-report__header {
  margin-bottom: var(--space-3);
}

.page-report__title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-text);
}

.page-report__date {
  font-size: var(--font-size-sm);
  color: var(--color-text-aux);
  margin-top: var(--space-1);
}

.page-report__meta {
  display: flex;
  justify-content: space-between;
  font-size: var(--font-size-sm);
  color: var(--color-text-sub);
  margin-bottom: var(--space-3);
}

.page-report__selfrating {
  color: var(--color-accent);
}

.page-report__section {
  padding: var(--space-1) 0;
}

.page-report__section-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-aux);
  margin-bottom: 4rpx;
}

.page-report__section-text {
  font-size: var(--font-size-base);
  color: var(--color-text);
  line-height: 1.6;
}

.page-report__divider {
  height: 1rpx;
  background-color: var(--color-divider);
  margin: var(--space-2) 0;
}

.page-report__hint {
  margin-top: var(--space-2);
  font-size: var(--font-size-xs);
  color: var(--color-text-aux);
  text-align: center;
}

.page-report__tip {
  margin-top: var(--space-1);
  font-size: var(--font-size-xs);
  color: var(--color-text-aux);
  text-align: center;
  opacity: 0.7;
}

.page-report__quota {
  text-align: center;
  font-size: var(--font-size-xs);
  color: var(--color-text-aux);
  margin: var(--space-2) 0;
}

.page-report__followup {
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.page-report__followup:last-child {
  border-bottom: none;
}

.page-report__followup-q {
  font-size: var(--font-size-sm);
  color: var(--color-text-sub);
  margin-bottom: 4rpx;
}

.page-report__followup-a {
  font-size: var(--font-size-sm);
  color: var(--color-text);
  line-height: 1.5;
}

.page-report__followup-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--color-white);
  padding: var(--space-3);
  border-top: 1rpx solid var(--color-divider);
  z-index: 999;
}

.page-report__followup-input {
  width: 100%;
  min-height: 120rpx;
  padding: var(--space-2);
  background-color: rgba(26, 27, 58, 0.04);
  border-radius: var(--radius-input);
  font-size: var(--font-size-base);
  box-sizing: border-box;
}

.page-report__followup-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
  margin-top: var(--space-2);
}