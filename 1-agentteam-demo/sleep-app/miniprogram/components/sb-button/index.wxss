.sb-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-btn);
  font-size: var(--font-size-base);
  font-weight: 500;
  padding: 16rpx 40rpx;
  cursor: pointer;
  border: none;
  outline: none;
  transition: opacity 0.2s ease;
}

.sb-btn--block {
  display: flex;
  width: 100%;
}

.sb-btn--small {
  padding: 12rpx 32rpx;
  font-size: var(--font-size-sm);
}

.sb-btn--medium {
  padding: 16rpx 40rpx;
  font-size: var(--font-size-base);
}

.sb-btn--large {
  padding: 24rpx 48rpx;
  font-size: var(--font-size-md);
}

.sb-btn--primary {
  background-color: var(--color-primary);
  color: var(--color-white);
}

.sb-btn--secondary {
  background-color: rgba(26, 27, 58, 0.06);
  color: var(--color-primary);
}

.sb-btn--text {
  background-color: transparent;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
}

.sb-btn--danger {
  background-color: var(--color-error);
  color: var(--color-white);
}

.sb-btn--disabled {
  opacity: 0.4;
  pointer-events: none;
}

.sb-btn--loading {
  opacity: 0.6;
  pointer-events: none;
}

.sb-btn--hover {
  opacity: 0.85;
}

.sb-btn__loading {
  margin-right: 8rpx;
}

.sb-btn__text {
  white-space: nowrap;
}